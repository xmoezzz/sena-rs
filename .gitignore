# Generated by Cargo
# will have compiled files and executables
debug
target
.ci-cache/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

docs/
testcase/
testcase-cn/
reverse/*
!reverse/*.md
!reverse/evidence/
reverse/evidence/*
!reverse/evidence/*.json
!reverse/evidence/*.py
!reverse/evidence/*.c
!reverse/evidence/*.rs
!reverse/evidence/runtime-audit/
reverse/evidence/runtime-audit/*
!reverse/evidence/runtime-audit/*.c
out/
tools/

/dist/
dist/
docs-build/

platform/macos/SenaLauncher/Vendor/librfvp.dylib
platform/macos/SenaLauncher/Vendor/*
platform/ios/SenaLauncher/Vendor/librfvp.a
platform/ios/SenaLauncher/Vendor/*
platform/wasm/pkg/*

.metals/
*.efi

# Android release signing keys are kept outside the repository.
*.jks
*.keystore
*.p12

# Version the reviewed PAL contracts, declarations, and nested source evidence.
!reverse/abi/
!reverse/abi/**
!reverse/contracts/
!reverse/contracts/**
!reverse/evidence/**/
!reverse/evidence/**/*.json
!reverse/evidence/**/*.py
!reverse/evidence/**/*.c
!reverse/evidence/**/*.rs
reverse/**/__pycache__/
